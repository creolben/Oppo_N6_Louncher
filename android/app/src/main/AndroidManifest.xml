<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The lock screen reads the sensor directly through the legacy
         FingerprintManager so no biometric system dialog is shown; that legacy
         path requires USE_FINGERPRINT (a normal, install-time permission). -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- The launcher's ambient/cross-app surfaces reach the network (browser
         handoffs, wallpaper previews); the main manifest was missing it while
         the debug manifest supplied it, so release builds silently lost it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Raising the lock activity on a screen-off broadcast is a background
         activity start. The overlay grant is one exemption; without it the
         lock surface is raised by a full-screen intent instead, which needs
         these. POST_NOTIFICATIONS is runtime-granted on Android 13+. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="ChronoFold"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- No showWhenLocked / showOnLockScreen / turnScreenOn here, and that
             absence is deliberate: ColorOS owns the lock screen (Native mode).
             Drawing over the keyguard is what made the launcher's own lock
             surface reachable while the device was locked, and it is also why
             the platform refuses this app an owned fingerprint session — while
             the device is locked, only the keyguard may use the sensor.

             The COSMIC lock surface is opt-in at runtime instead, through the
             `setLockScreenOverlayEnabled` channel method, so the occlusion
             exists only while the user has explicitly asked for it rather than
             from the moment the process starts. -->
        <!-- Both launcher activities pin portrait. This is honoured on the
             cover display (sw351dp) and deliberately ignored by Android 16 on
             the inner display (sw692dp): at targetSdk 36 the platform ignores
             orientation restrictions when the smallest width is >= 600dp, so
             the inner display must lay out at any aspect ratio. The manifest is
             the one source; the Dart side must not re-assert orientations. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- The lock surface raised over a foreign task on screen-off. Its own
             task, so finishing it reveals exactly the app that was underneath
             instead of the HOME task. It is not exported and has no
             intent-filter: only this process raises it, and it is never a
             general entry point. showWhenLocked/turnScreenOn are asserted in
             the manifest and again in LockActivity.onCreate. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:taskAffinity="com.launcher.chronofold.mylauncher.lock"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/LaunchTheme"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode">
            <!-- Same handoff as MainActivity: LaunchTheme until Flutter's first
                 frame, then the dark NormalTheme, so the lock surface never
                 flashes the (light) launch background. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
        </activity>

        <!-- The one thing MediaSessionManager needs to answer: an enabled
             notification listener. It reads nothing and posts nothing; it
             exists so the lock screen can mirror the active media session.
             The user grants notification access once (P5 asks); the lock
             screen itself never nags. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="ChronoFold media"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The optional, non-root ambient layer of the hybrid theme. Android's
             own preview flow decides whether it is applied; this service never
             changes the user's wallpaper by itself. -->
        <service
            android:name=".CosmicLiveWallpaperService"
            android:exported="true"
            android:label="@string/cosmic_live_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/cosmic_live_wallpaper" />
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Web search handoff. Package-visibility filtering applies on Android
             11+, so without these declarations resolveActivity() for the web
             search and browser intents returns null and the handoff fails
             silently. Verified on ColorOS 16 (CPH2765): ACTION_WEB_SEARCH is
             answered by 7 installed apps and has no platform default. -->
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Lock-screen quick shortcuts. Package-visibility filtering applies on
             Android 11+, so resolveActivity() for these returns null without a
             declaration and the shortcut fallback silently fails. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE"/>
        </intent>
    </queries>
</manifest>
